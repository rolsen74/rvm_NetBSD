# $NetBSD$
#
# GENERIC kernel configuration for the RVM virtual CPU.
#
# Initial NetBSD/RVM port configuration.
# The RVM machine is a 64-bit virtual CPU running under VMRun.
# This file deliberately excludes Amiga hardware and unimplemented
# RVM devices. Enable drivers as they are added to files.rvm.
#
# Full kernel configuration/build support is still under development.

include "arch/rvm/conf/std.rvm"

options         INCLUDE_CONFIG_FILE      # Embed configuration in the kernel

# Keep the first kernel small and debuggable.
maxusers        8
options         HZ=50                   # ICNT scheduler clock frequency
# FHR debug sections are not supported by the current external assembler.
#options        DIAGNOSTIC              # Extra kernel consistency checks
#options        DEBUG                   # Additional debugging checks
#options        DDB                     # Kernel debugger (needs RVM support)

# Networking through the optional VMEmu TAP device.
options         INET                    # IPv4
#options        INET6                   # IPv6

# Filesystems. DISKROOT selects an FFS root on the optional HARDFILE disk.
file-system     FFS                     # Berkeley Fast File System
file-system     TMPFS                   # Memory-backed filesystem
file-system     PTYFS                   # Dynamic pseudo-terminal nodes
#file-system    KERNFS                  # Kernel information filesystem
#file-system    NFS                     # Network filesystem client

# RVM virtual devices. Console output is registered directly at startup.
mainbus0        at root
rvmrnd0         at mainbus0
cpu0            at mainbus0
ld0             at mainbus0             # Optional VMEmu HARDFILE at its default address
#rvmclock0      at mainbus0             # TODO: timer
rvmnet0         at mainbus0             # Optional VMEmu TAP Ethernet

# Basic pseudo-devices (enable when the associated kernel support is ready).
pseudo-device   loop                    # Loopback network interface
pseudo-device   bpfilter                # Packet capture and DHCP
pseudo-device   pty                     # Pseudo-terminals
#pseudo-device  clockctl                # User clock control

# Interactive root selection; DISKROOT overrides this with ld0a/ffs.
config          netbsd root on ? type ?

# Optional local overrides.
cinclude        "arch/rvm/conf/GENERIC.local"
