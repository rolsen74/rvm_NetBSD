+rvm_initial_elimination_offset (int from, int to)
+{
+  HOST_WIDE_INT size = rvm_frame_alloc_size ();
+  HOST_WIDE_INT saved = 8 * (1 + popcount_hwi (rvm_frame_save_mask ()));
+  /* Locals lie immediately below PUSHF, outgoing arguments below locals.
