--- /dev/null
+++ b/gcc/config/rvm/rvm-extensions.md
@@ -0,0 +1,15 @@
+;; GCC canonicalizes some unsigned narrow-to-quad conversions as masks.
+;; Match those before the generic AND patterns: EXTU clears all upper bits.
+(define_insn "*rvm_zero_extend_mask"
+  [(set (match_operand:DI 0 "register_operand" "=r")
+        (and:DI (match_operand:DI 1 "register_operand" "r")
+                (match_operand:DI 2 "const_int_operand" "n")))]
+  "INTVAL (operands[2]) == 255 || INTVAL (operands[2]) == 65535
+   || INTVAL (operands[2]) == HOST_WIDE_INT_UC (0xffffffff)"
+{
+  if (INTVAL (operands[2]) == 255)
+    return "rextu.b\t%1,%0";
+  if (INTVAL (operands[2]) == 65535)
+    return "rextu.w\t%1,%0";
+  return "rextu.l\t%1,%0";
+})
