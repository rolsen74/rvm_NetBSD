+;; Every EXTS/EXTU writes a complete 64-bit integer register. Describe
+;; direct byte/word conversions to all wider GCC modes, rather than forcing
+;; GCC to chain byte->word->long->quad instructions.
+(define_insn "extendqisi2"
+  [(set (match_operand:SI 0 "register_operand" "=r")
+        (sign_extend:SI (match_operand:QI 1 "nonimmediate_operand" "rm")))]
+  ""
+{
+  return REG_P (operands[1]) ? "rexts.b\t%1,%0" : "exts.b\t%1,%0";
+})
+
+(define_insn "extendqidi2"
+  [(set (match_operand:DI 0 "register_operand" "=r")
+        (sign_extend:DI (match_operand:QI 1 "nonimmediate_operand" "rm")))]
