+/* Control-register IDs are part of the v0000 instruction ABI. */
+static int
+rvm_read_creg ( const char * buffer, int * pos, int * reg )
+{
+    static const char * const names[] = {
+        "sr", "pc", "cr", "usp", "ssp", "vbr", "mst", "mut",
+        "inst", "inte", "ud1", "ud2", "fpcr", "fpsr"
+    };
+    int p = *pos;
+    unsigned int i;
+    while ( buffer[p] == ' ' || buffer[p] == '\t' ) p++;
+    for ( i = 0; i < sizeof(names) / sizeof(names[0]); i++ )
+    {
+        unsigned int n = 0;
+        while ( names[i][n] &&
+                tolower ( (unsigned char) buffer[p+n] ) == names[i][n] ) n++;
+        if ( ! names[i][n] && ! isalnum ( (unsigned char) buffer[p+n] ) &&
+             buffer[p+n] != '_' && buffer[p+n] != '.' && buffer[p+n] != '$' )
+        {
+            *pos = p + n;
+            *reg = i;
+            return true;
+        }
+    }
+    return false;
+}
