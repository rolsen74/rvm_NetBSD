+/* A register plus signed56 occupies the same nine bytes as ABS64. This
+   handles instruction sites in sections that cannot safely be resized. */
+static bool
+fhr_Relax_Base (bfd *abfd, struct bfd_link_info *info,
+                struct fhr_section_data *data, asection *input,
+                asection *target, arelent *reloc, bfd_vma offset)
+{
+  struct fhr_data *object = input->owner->tdata.any;
+  unsigned int reg = fhr_base_register (target);
+  bool marked = false;
+  int i;
+  bfd_vma value;
+  if (!reg || !fhr_bases_enabled (info) || !(input->flags & SEC_CODE)
+      || fhr_base_symbol ((*reloc->sym_ptr_ptr)->name)
+      || !data->buf_data || offset < 1 || offset > data->buf_size
+      || data->buf_size - offset < 8 || data->buf_data[offset - 1] != 0x37) return false;
+  for (i = 0; i < object->InputSymbolCount; ++i)
+    {
+      asymbol *sym = object->InputSymbols[i];
+      if (sym->section == input && !strncmp (sym->name, "__rvm_lr_data_", 14)
+          && sym->value + 1 == reloc->address) { marked = true; break; }
+    }
+  if (!marked && !fhr_Is_Pcrel_Site (input, reloc->address)) return false;
+  value = bfd_get_64 (abfd, data->buf_data + offset) - target->vma;
+  if ((bfd_signed_vma)value < -INT64_C (36028797018963968)
+      || (bfd_signed_vma)value > INT64_C (36028797018963967)) return false;
+  data->buf_data[offset - 1] = 0x1a;
+  data->buf_data[offset] = reg;
+  fhr_lr_write (data->buf_data + offset + 1, 7, value);
+  return true;
+}
