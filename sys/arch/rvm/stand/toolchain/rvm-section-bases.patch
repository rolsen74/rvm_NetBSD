+/* The ABI is opt-in: startup declares that it initializes the bases before
+   any converted instruction, and restores kernel bases at user trap entry. */
+static bool
+fhr_bases_enabled (struct bfd_link_info *info)
+{
+  struct bfd_link_hash_entry *h = bfd_link_hash_lookup (
+      info->hash, "__rvm_section_bases_v1", false, false, true);
+  return h && h->type == bfd_link_hash_defined
+         && !bfd_is_und_section (h->u.def.section);
+}
+
+static unsigned int
+fhr_base_register (asection *sec)
+{
+  if (!sec || !sec->output_section || bfd_is_abs_section (sec)
+      || bfd_is_com_section (sec)) return 0;
+  sec = sec->output_section;
+  if (sec->flags & SEC_CODE) return 0;
+  if (!strcmp (sec->name, ".rodata")) return 50;
+  if (!strcmp (sec->name, ".data")) return 51;
+  if (!strcmp (sec->name, ".bss")) return 52;
+  return 0;
+}
+
+static bool
+fhr_base_symbol (const char *name)
+{
+  return !strcmp (name, "__rvm_rodata_base")
+         || !strcmp (name, "__rvm_data_base")
+         || !strcmp (name, "__rvm_bss_base");
+}
