--- a/gcc/config/rvm/rvm.md
+++ b/gcc/config/rvm/rvm.md
@@ -26,6 +26,18 @@
 (define_predicate "rvm_data_operand"
   (and (match_operand 0 "general_operand")
        (not (match_code "symbol_ref,label_ref,const"))))
+
+ ;; Single-precision values occupy one GPR and move as raw 32-bit bits.
+;; GCC's generic multiword fallback cannot handle SFmode on a 64-bit CPU.
+(define_expand "movsf"
+  [(set (match_operand:SF 0 "nonimmediate_operand")
+        (match_operand:SF 1 "general_operand"))]
+  ""
+{
+  emit_move_insn (gen_lowpart (SImode, operands[0]),
+                  gen_lowpart (SImode, operands[1]));
+  DONE;
+})
 
 ;; Vcmds first, Rcmds next
 (include "rvm-inst-v.md")
