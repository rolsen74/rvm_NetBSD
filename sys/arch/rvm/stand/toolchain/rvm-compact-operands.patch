+  {INT64_C (127), -INT64_C (128), 1, 2},
+  {INT64_C (32767), -INT64_C (32768), 2, 3},
+  {INT64_C (8388607), -INT64_C (8388608), 3, 4},
+  {INT64_C (2147483647), -INT64_C (2147483648), 4, 5},
+  {INT64_C (549755813887), -INT64_C (549755813888), 5, 6},
+  {INT64_C (140737488355327), -INT64_C (140737488355328), 6, 7},
+  {INT64_C (36028797018963967), -INT64_C (36028797018963968), 7, 8},
+  {0, 0, 8, 0},
+};
+
+static bool
+rvm_relaxable_opcode (unsigned int opcode)
+{
+  switch (opcode)
+    {
+    case Opcode_Jsr: case Opcode_Jmp: case Opcode_Lea_q:
+    case Opcode_Bss: case Opcode_Bsc: case Opcode_Bcs: case Opcode_Bcc:
+    case Opcode_Bvs: case Opcode_Bvc: case Opcode_Beq: case Opcode_Bne:
+    case Opcode_Bmi: case Opcode_Bpl: case Opcode_Bxs: case Opcode_Bxc:
+    case Opcode_Bhi: case Opcode_Bls: case Opcode_Bgt: case Opcode_Bge:
+    case Opcode_Blt: case Opcode_Ble: case Opcode_Bis: case Opcode_Bic:
+      return true;
+    default:
+      return false;
+    }
+}
+
+static bool
+rvm_assemble_relaxable (struct OStruct2 *op, char *args)
+{
+  expressionS exp;
+  char *saved, *end;
+  int pos, reg = 0, tail = op->OpcodeID == Opcode_Lea_q ? 2 : 0;
+  uint8_t *bytes;
+  fragS *fragment;
+  if (!(now_seg->flags & SEC_CODE) || !rvm_relaxable_opcode (op->OpcodeID))
+    return false;
+  while (*args == ' ' || *args == '\t') ++args;
+  /* Parenthesized numeric/register forms retain their existing semantics. */
+  if (!(isalpha ((unsigned char)*args) || *args == '_' || *args == '.'))
+    return false;
+  saved = input_line_pointer;
+  input_line_pointer = args;
+  expression (&exp);
+  end = input_line_pointer;
+  input_line_pointer = saved;
+  if (exp.X_op != O_symbol)
+    return false;
+  pos = end - args;
+  while (args[pos] == ' ' || args[pos] == '\t') ++pos;
+  if (tail)
+    {
+      if (args[pos++] != ',' || !rvm_read_ireg (args, &pos, &reg))
+        return false;
+    }
+  while (args[pos] == ' ' || args[pos] == '\t') ++pos;
+  if (args[pos] && args[pos] != ';') return false;
+  /* Reserve maximum storage before taking pointers into the fragment. */
+  frag_grow (13);
+  bytes = (uint8_t *)frag_more (3);
+  bytes[0] = op->OpcodeID >> 8;
+  bytes[1] = op->OpcodeID;
+  bytes[2] = OAM_55;
+  rvm_mark_pcrel_site (bytes, 11 + tail, op->OpcodeID);
+  fragment = frag_now;
+  char *variable = frag_var (rs_machine_dependent, 8 + tail, 1 + tail,
+                            1, exp.X_add_symbol, exp.X_add_number,
+                            (char *)bytes);
+  memset (variable, 0, 8 + tail);
+  if (tail) { variable[8] = OAM_Reg; variable[9] = reg; }
+  /* fr_var stores the fixed-size suffix; width is fr_subtype. */
+  fragment->fr_var = tail;
+  return true;
+}
