--- a/gcc/config/rvm/rvm.md
+++ b/gcc/config/rvm/rvm.md
@@ -21,8 +21,62 @@
 (define_c_enum "unspec" [
   UNSPEC_PUSHF
   UNSPEC_POPF
+  UNSPEC_FLAG_WRITE
+  UNSPEC_FLAG_SNAPSHOT
+  UNSPEC_READ_SR
+  UNSPEC_READ_CR
 ])
 
+
+;; Explicit CPU state operations are volatile compiler barriers. The snapshot
+;; form captures SR/CR in the same instruction, before any compiler-generated
+;; moves or arithmetic can overwrite the flags. No SETS opcode exists.
+(define_insn "rvm_flag_write"
+  [(unspec_volatile [(match_operand 0 "const_int_operand" "n")] UNSPEC_FLAG_WRITE)
+   (clobber (reg:CC CC_REG))
+   (clobber (mem:BLK (scratch)))]
+  "IN_RANGE (INTVAL (operands[0]), 0, 12)"
+{
+  static const char *const names[] = {
+    "clrs", "clrc", "setc", "clrv", "setv", "clrz", "setz",
+    "clrn", "setn", "clrx", "setx", "clri", "seti"
+  };
+  return names[INTVAL (operands[0])];
+}
+  [(set_attr "rvm_result_z" "no")])
+
+(define_insn "rvm_flag_snapshot"
+  [(set (match_operand:DI 0 "register_operand" "=r")
+        (unspec_volatile:DI [(match_operand 1 "const_int_operand" "n")]
+                            UNSPEC_FLAG_SNAPSHOT))
+   (clobber (reg:CC CC_REG))
+   (clobber (mem:BLK (scratch)))]
+  "IN_RANGE (INTVAL (operands[1]), 1, 12)"
+{
+  static const char *const names[] = {
+    "", "clrc", "setc", "clrv", "setv", "clrz", "setz",
+    "clrn", "setn", "clrx", "setx", "clri", "seti"
+  };
+  output_asm_insn (names[INTVAL (operands[1])], operands);
+  return INTVAL (operands[1]) >= 11 ? "mfctrl\tcr,%0" : "mfctrl\tsr,%0";
+}
+  [(set_attr "rvm_result_z" "no")])
+
+(define_insn "rvm_read_sr"
+  [(set (match_operand:DI 0 "register_operand" "=r")
+        (unspec_volatile:DI [(reg:CC CC_REG)] UNSPEC_READ_SR))
+   (clobber (mem:BLK (scratch)))]
+  ""
+  "mfctrl\tsr,%0"
+  [(set_attr "rvm_result_z" "no")])
+
+(define_insn "rvm_read_cr"
+  [(set (match_operand:DI 0 "register_operand" "=r")
+        (unspec_volatile:DI [(const_int 0)] UNSPEC_READ_CR))
+   (clobber (mem:BLK (scratch)))]
+  ""
+  "mfctrl\tcr,%0"
+  [(set_attr "rvm_result_z" "no")])
 
 ;; Symbolic addresses must use LEA: GAS cannot size symbolic immediates.
 (define_predicate "rvm_data_operand"
