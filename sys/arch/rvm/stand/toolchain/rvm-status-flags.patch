 }
 
+/* Flag builtins return a snapshot taken immediately after the operation.
+   Keeping the operation and snapshot in one RTL instruction prevents reload
+   or scheduling from changing the flags before they are captured. Ignoring
+   the return value emits only the two-byte flag instruction. */
+static const char *const rvm_flag_builtins[] = {
+  "__builtin_rvm_clrs",
+  "__builtin_rvm_clrc", "__builtin_rvm_setc",
+  "__builtin_rvm_clrv", "__builtin_rvm_setv",
+  "__builtin_rvm_clrz", "__builtin_rvm_setz",
+  "__builtin_rvm_clrn", "__builtin_rvm_setn",
+  "__builtin_rvm_clrx", "__builtin_rvm_setx",
+  "__builtin_rvm_clri", "__builtin_rvm_seti"
+};
+static const unsigned rvm_flag_builtin_count = ARRAY_SIZE (rvm_flag_builtins);
+static tree rvm_builtin_decls[ARRAY_SIZE (rvm_flag_builtins) + 2];
+
+static void
+rvm_init_builtins (void)
+{
+  tree type = build_function_type_list (long_unsigned_type_node, NULL_TREE);
+  for (unsigned i = 0; i < ARRAY_SIZE (rvm_builtin_decls); ++i)
+    {
+      const char *name = i < rvm_flag_builtin_count ? rvm_flag_builtins[i]
+        : i == rvm_flag_builtin_count ? "__builtin_rvm_get_sr"
+        : "__builtin_rvm_get_cr";
+      tree builtin_type = i == 0 ? build_function_type_list (void_type_node, NULL_TREE) : type;
+      tree decl = add_builtin_function (name, builtin_type, i, BUILT_IN_MD, NULL, NULL_TREE);
+      TREE_NOTHROW (decl) = 1;
+      rvm_builtin_decls[i] = decl;
+    }
+}
+
+static tree
+rvm_builtin_decl (unsigned code, bool initialize_p ATTRIBUTE_UNUSED)
+{
+  return code < ARRAY_SIZE (rvm_builtin_decls) ? rvm_builtin_decls[code] : error_mark_node;
+}
+
+static rtx
+rvm_expand_builtin (tree exp, rtx target, rtx subtarget ATTRIBUTE_UNUSED,
+                    machine_mode mode ATTRIBUTE_UNUSED, int ignore)
+{
+  tree decl = TREE_OPERAND (CALL_EXPR_FN (exp), 0);
+  unsigned code = DECL_MD_FUNCTION_CODE (decl);
+  if (code < rvm_flag_builtin_count && (ignore || code == 0))
+    {
+      emit_insn (gen_rvm_flag_write (GEN_INT (code)));
+      return const0_rtx;
+    }
+  if (!target || GET_MODE (target) != DImode || !REG_P (target))
+    target = gen_reg_rtx (DImode);
+  if (code < rvm_flag_builtin_count)
+    {
+      /* CLRS switches to user mode, where MFCTRL SR is privileged. Its
+         result is deliberately unavailable: use CLRS only for the mode
+         transition, with no captured result. */
+      if (code == 0)
+        {
+          error ("the result of %<__builtin_rvm_clrs%> is unavailable after leaving supervisor mode");
+          return const0_rtx;
+        }
+      emit_insn (gen_rvm_flag_snapshot (target, GEN_INT (code)));
+    }
+  else if (code == rvm_flag_builtin_count)
+    emit_insn (gen_rvm_read_sr (target));
+  else if (code == rvm_flag_builtin_count + 1)
+    emit_insn (gen_rvm_read_cr (target));
+  else
+    gcc_unreachable ();
+  return target;
+}
+
+#undef TARGET_INIT_BUILTINS
+#define TARGET_INIT_BUILTINS rvm_init_builtins
+#undef TARGET_BUILTIN_DECL
+#define TARGET_BUILTIN_DECL rvm_builtin_decl
+#undef TARGET_EXPAND_BUILTIN
+#define TARGET_EXPAND_BUILTIN rvm_expand_builtin
+
 /* The Global `targetm' Variable.  */
 
