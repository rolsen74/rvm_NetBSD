--- a/gcc/config/rvm/rvm.cc
+++ b/gcc/config/rvm/rvm.cc
@@ -836,12 +836,61 @@
   HOST_WIDE_INT saved = rvm_omit_pushf_p () ? 0
     : 8 * (1 + popcount_hwi (rvm_frame_save_mask ()));
   /* Locals lie immediately below PUSHF, outgoing arguments below locals.
-     The argument pointer addresses the caller's 64-byte register homes,
+     The argument pointer addresses the caller's argument area,
      immediately above JSR's eight-byte return address. */
   if (from == ARG_POINTER_REGNUM)
