+}
+
+/* Fixed, scalar signatures that fit in R2-R9 need no caller register
+   homes. GCC spills address-taken parameters into the callee's own frame.
+   Keep the established home/stack layout for varargs, stacked arguments,
+   aggregates and calls without a complete signature. DECL_OR_TYPE is a
+   FUNCTION_DECL for direct calls/definitions and a FUNCTION_TYPE for
+   indirect calls. Library-call expansion may pass NULL_TREE. */
+int
+rvm_reg_parm_stack_space (tree decl_or_type)
+{
+  if (!decl_or_type)
+    return 8 * UNITS_PER_WORD;
+  tree decl = TREE_CODE (decl_or_type) == FUNCTION_DECL ? decl_or_type : NULL_TREE;
+  tree type = decl ? TREE_TYPE (decl) : decl_or_type;
+  if (TREE_CODE (type) != FUNCTION_TYPE || stdarg_p (type))
+    return 8 * UNITS_PER_WORD;
+  tree result = TREE_TYPE (type);
+  if (AGGREGATE_TYPE_P (result) || TREE_CODE (result) == COMPLEX_TYPE
+      || (result != void_type_node && int_size_in_bytes (result) > UNITS_PER_WORD))
+    return 8 * UNITS_PER_WORD;
+
+  unsigned slots = 0;
+  tree args = TYPE_ARG_TYPES (type);
+  if (!args)
+    {
+      /* An old-style definition still has its declared parameters. An
+         unprototyped call must conservatively retain the old call area. */
+      if (decl != current_function_decl)
+        return 8 * UNITS_PER_WORD;
+      for (tree arg = DECL_ARGUMENTS (decl); arg; arg = DECL_CHAIN (arg))
+        {
+          tree param = TREE_TYPE (arg);
+          HOST_WIDE_INT size = int_size_in_bytes (param);
+          if (AGGREGATE_TYPE_P (param) || TREE_CODE (param) == COMPLEX_TYPE
+              || size <= 0 || size > UNITS_PER_WORD || ++slots > 8)
+            return 8 * UNITS_PER_WORD;
+        }
+    }
+  else
+    for (; args && args != void_list_node; args = TREE_CHAIN (args))
+      {
+        tree param = TREE_VALUE (args);
+        HOST_WIDE_INT size = int_size_in_bytes (param);
+        if (AGGREGATE_TYPE_P (param) || TREE_CODE (param) == COMPLEX_TYPE
+            || size <= 0 || size > UNITS_PER_WORD || ++slots > 8)
+          return 8 * UNITS_PER_WORD;
+      }
   return 0;
 }
 
