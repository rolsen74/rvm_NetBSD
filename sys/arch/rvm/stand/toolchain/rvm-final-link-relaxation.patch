+bfd_reloc_code_real_type
+rvm_parse_cons (expressionS *exp, int bytes ATTRIBUTE_UNUSED)
+{
+  char *start = input_line_pointer, *end, *p;
+  bool identifier = false;
+  expression (exp);
+  end = input_line_pointer;
+  for (p = start; p < end; ++p)
+    {
+      /* Skip whole numeric tokens, including 0x... and 0b... literals. */
+      if (isdigit ((unsigned char)*p))
+        { while (p + 1 < end && isalnum ((unsigned char)p[1])) ++p; }
+      else if (isalpha ((unsigned char)*p) || *p == '_' || *p == '.' || *p == '$')
+        identifier = true;
+    }
