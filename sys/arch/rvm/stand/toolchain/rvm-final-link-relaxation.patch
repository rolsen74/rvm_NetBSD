+/* Versioned opt-in: only instruction-only, unaligned code sections may be
+   resized by the final linker. Mapping symbols cover every symbolic PC use.
+   Raw data, explicit PC modes and symbolic constant differences opt out. */
+static segT rvm_lr_seen[4][1024];
+static unsigned int rvm_lr_count[4];
+
+void
+rvm_linkrelax_note (int kind)
+{
+  static unsigned long serial;
+  static uint64_t identity;
+  if (!identity)
+    {
+      const unsigned char *p = (const unsigned char *)out_file_name;
+      identity = UINT64_C (14695981039346656037);
+      while (*p) { identity ^= *p++; identity *= UINT64_C (1099511628211); }
+    }
+  char name[128];
+  symbolS *sym;
+  unsigned int i;
+  if (kind != 2 && !(now_seg->flags & SEC_CODE)) return;
+  for (i = 0; i < rvm_lr_count[kind]; ++i)
+    if (rvm_lr_seen[kind][i] == now_seg) return;
+  if (rvm_lr_count[kind] == 1024) as_fatal ("Too many RVM relaxation sections");
+  rvm_lr_seen[kind][rvm_lr_count[kind]++] = now_seg;
+  snprintf (name, sizeof name, "__rvm_lr_%s_%016" PRIx64 "_%lu",
+            kind == 0 ? "v1" : kind == 1 ? "block" : kind == 2 ? "object_block" : "end",
+            identity, serial++);
+  sym = symbol_new (name, now_seg, frag_now, frag_now_fix ());
+  S_SET_EXTERNAL (sym);
+  symbol_table_insert (sym);
+}
+
+void
+rvm_linkrelax_end (void)
+{
+  unsigned int i;
+  for (i = 0; i < rvm_lr_count[0]; ++i)
+    {
+      subseg_set (rvm_lr_seen[0][i], 0);
+      rvm_linkrelax_note (3);
+    }
+}
