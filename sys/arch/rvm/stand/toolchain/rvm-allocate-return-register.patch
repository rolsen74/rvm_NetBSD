+
+/* Multiword return operands occupy R0/R1. LRA cannot reload a return
+   pair with only its first half allocatable, so honor an explicit reservation
+   of either half by keeping the complete pair fixed. */
+static void
+rvm_conditional_register_usage (void)
+{
+  if (fixed_regs[RVM_R0] || fixed_regs[RVM_R1])
+    fixed_regs[RVM_R0] = fixed_regs[RVM_R1] = 1;
 }
 
