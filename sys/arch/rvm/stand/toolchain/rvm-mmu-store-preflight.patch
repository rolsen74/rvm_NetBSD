+/* A single guest store must not commit its first page before a later
+ * page raises an MMU fault.  In particular, four-byte-aligned quadword
+ * atomics can straddle pages and must restart intact after COW faults.
+ * Check every destination mapping before touching target RAM or cache.
+ * Page-table accessed/dirty updates are allowed during this preflight.
+ * Physical device/bus errors remain the responsibility of the device.
+ */
+static S32
+myPreflightWrite ( VMMemIntern * in )
+{
+	U64 original = in->buf_Adr;
+	U64 physical = in->phy_Adr;
+	U64 address = original;
+	S32 remaining = in->buf_Len;
+	S32 offset = address & MMU_MASK_PAGE;
+
+	if ( ! in->flag_write || remaining <= MMU_PAGE_SIZE - offset )
+		return FALSE;
+
+	while ( remaining > 0 )
+	{
+		U64 mapping;
+		S32 length;
+
+		in->buf_Adr = address;
+		if ( myTranslate ( in, address & ~MMU_MASK_PAGE, &mapping ) )
+			return TRUE;
+		in->phy_Adr = ( mapping & ~MMU_MASK_PAGE ) + offset;
+		if ( myFlagCheck ( in, mapping & MMU_MASK_PAGE ) )
+			return TRUE;
+		length = MMU_PAGE_SIZE - offset;
+		if ( length > remaining )
+			length = remaining;
+		remaining -= length;
+		address += length;
+		offset = 0;
+	}
+	in->buf_Adr = original;
+	in->phy_Adr = physical;
+	return FALSE;
+}
+
 /* Translate/check access before the physical-cache lookup. Cache hits
