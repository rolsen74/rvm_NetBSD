+/* Real page tables exercise both MMU memory paths, with and without TLB
+ * hits.  Denied or absent second pages must leave RAM AND cached data intact.
+ * Test scalar quadwords and a full saved-register-sized memory operation.
+ */
+static void
+cross_page_stores ( VMContext * context )
+{
+	ram->mem_MemBuf = realloc ( ram->mem_MemBuf, 0x100000 );
+	assert ( ram->mem_MemBuf );
+	memset ( ram->mem_MemBuf + 65536, 0, 0xf0000 );
+	ram->mem_MemSize = ram->mem_MemEnd = 0x100000;
+	for ( unsigned mode = 0; mode < 6; mode++ )
+	{
+		VMCPU * testcpu = CPU_Create ( context );
+		VMCPUState state;
+		U64 policy = mode / 2 == 1 ? MMU_CACHE_WRITEBACK : MMU_CACHE_WRITETHROUGH;
+		U64 flags = MMU_PAGE_VALID | MMU_PAGE_READWRITE | policy;
+		U8 input[520], output[520];
+		assert ( testcpu );
+		memset ( &state, 0, sizeof ( state ) );
+		state.cpu = testcpu;
+		state.ctx = context;
+		testcpu->cpu_ControlRegsPtr[CReg_CR] = CRF_MMU |
+			( mode / 2 ? CRF_DataCache : 0 ) | ( mode & 1 ? CRF_TLB : 0 );
+		testcpu->cpu_ControlRegsPtr[CReg_SR] = 0;
+		testcpu->cpu_ControlRegsPtr[CReg_MUT] = 0x8000;
+		memset ( ram->mem_MemBuf + 0x8000, 0, 6 * 0x800 );
+		for ( unsigned level = 0; level < 5; level++ )
+			put64 ( 0x8000 + level * 0x800, ( 0x8800 + level * 0x800 ) | flags );
+		put64 ( 0xa800, 0x20000 | flags );
+		for ( unsigned size = 8; size <= sizeof ( input ); size += 512 )
+		{
+			memset ( input, size == 8 ? 0x5a : 0xa5, size );
+			for ( unsigned absent = 0; absent < 2; absent++ )
+			{
+				put64 ( 0xa808, absent ? 0 : 0x30000 | ( flags & ~MMU_PAGE_WRITEABLE ) );
+				Mem_InvalidateTLB ( testcpu, TRUE, 0 );
+				assert ( State_Data_WriteMem ( &state, 65532, size, input ) != RC_Okay );
+				assert ( State_Data_ReadMem ( &state, 65532, 4, output ) == RC_Okay );
+				for ( unsigned byte = 0; byte < 4; byte++ )
+					assert ( output[byte] == ( size == 8 ? 0 : 0x5a ) );
+			}
+			put64 ( 0xa808, 0x30000 | flags );
+			Mem_InvalidateTLB ( testcpu, TRUE, 0 );
+			assert ( State_Data_WriteMem ( &state, 65532, size, input ) == RC_Okay );
+			assert ( State_Data_ReadMem ( &state, 65532, size, output ) == RC_Okay );
+			assert ( memcmp ( output, input, size ) == 0 );
+		}
+		/* Discard test-local dirty lines before resetting the physical fixture. */
+		CPU_Delete ( testcpu );
+		memset ( ram->mem_MemBuf + 0x20000, 0, 0x20000 );
+	}
+	puts ( "PASS: cross-page stores preserve memory on MMU faults, cached/uncached and TLB on/off" );
+}
