+;; Fuse the mask and its EQ/NE consumer. No intermediate boolean is needed.
+(define_insn "rvm_btst_branch<mode>"
+  [(set (pc)
+        (if_then_else
+          (match_operator 0 "rvm_eqne_operator"
+            [(and:RVM_INT (match_operand:RVM_INT 1 "nonimmediate_operand" "r,m")
+                          (match_operand:RVM_INT 2 "const_int_operand" "n,n"))
+             (const_int 0)])
+          (label_ref (match_operand 3 "" "")) (pc)))
+   (clobber (reg:CC CC_REG))]
+  "rvm_bit_index (operands[2], <MODE>mode, false) >= 0
+   && (<MODE>mode == DImode || REG_P (operands[1]))"
+{
+  operands[4] = GEN_INT (rvm_bit_index (operands[2], <MODE>mode, false));
+  output_asm_insn (REG_P (operands[1]) ? "vbtst\t%4,%1" : "btst\t%4,%1", operands);
+  return GET_CODE (operands[0]) == EQ ? "beq\t%3" : "bne\t%3";
+})
+
+(define_insn "rvm_btst_dynamic_branch"
+  [(set (pc)
+        (if_then_else
+          (match_operator 0 "rvm_eqne_operator"
+            [(and:DI (match_operand:DI 1 "nonimmediate_operand" "r,m")
+                     (ashift:DI (const_int 1)
+                                (match_operand:DI 2 "register_operand" "r,r")))
+             (const_int 0)])
+          (label_ref (match_operand 3 "" "")) (pc)))
+   (clobber (reg:CC CC_REG))]
+  ""
+{
+  output_asm_insn (REG_P (operands[1]) ? "rbtst\t%2,%1" : "btst\t%2,%1", operands);
+  return GET_CODE (operands[0]) == EQ ? "beq\t%3" : "bne\t%3";
+})
+
+(define_insn "rvm_btst_extract_branch<mode>"
+  [(set (pc)
+        (if_then_else
+          (match_operator 0 "rvm_eqne_operator"
+            [(zero_extract:RVM_INT
+               (match_operand:RVM_INT 1 "nonimmediate_operand" "r,m")
+               (const_int 1) (match_operand 2 "const_int_operand" "n,n"))
+             (const_int 0)])
+          (label_ref (match_operand 3 "" "")) (pc)))
+   (clobber (reg:CC CC_REG))]
+  "IN_RANGE (INTVAL (operands[2]), 0, GET_MODE_BITSIZE (<MODE>mode) - 1)
+   && (<MODE>mode == DImode || REG_P (operands[1]))"
+{
+  operands[4] = GEN_INT (GET_MODE_BITSIZE (<MODE>mode) - 1 - INTVAL (operands[2]));
+  output_asm_insn (REG_P (operands[1]) ? "vbtst\t%4,%1" : "btst\t%4,%1", operands);
+  return GET_CODE (operands[0]) == EQ ? "beq\t%3" : "bne\t%3";
+})
+
+(define_insn "rvm_btst_extract_dynamic_branch"
+  [(set (pc)
+        (if_then_else
+          (match_operator 0 "rvm_eqne_operator"
+            [(zero_extract:DI (match_operand:DI 1 "nonimmediate_operand" "r,m")
+                              (const_int 1)
+                              (minus:DI (const_int 63)
+                                (match_operand:DI 2 "register_operand" "r,r")))
+             (const_int 0)])
+          (label_ref (match_operand 3 "" "")) (pc)))
+   (clobber (reg:CC CC_REG))]
+  ""
+{
+  output_asm_insn (REG_P (operands[1]) ? "rbtst\t%2,%1" : "btst\t%2,%1", operands);
+  return GET_CODE (operands[0]) == EQ ? "beq\t%3" : "bne\t%3";
+})
