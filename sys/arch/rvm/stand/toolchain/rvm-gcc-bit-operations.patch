+static bool
+rvm_dynamic_bit_mask_p (rtx x, bool invert)
+{
+  if (invert && GET_CODE (x) == ROTATE)
+    return XEXP (x, 0) == GEN_INT (-2) && REG_P (XEXP (x, 1));
+  if (invert)
+    {
+      if (GET_CODE (x) != NOT)
+        return false;
+      x = XEXP (x, 0);
+    }
+  return GET_CODE (x) == ASHIFT && XEXP (x, 0) == const1_rtx
+    && REG_P (XEXP (x, 1));
+}
