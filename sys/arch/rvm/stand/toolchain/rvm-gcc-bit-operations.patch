+/* Inspect only the bits defined by this integer mode. */
+int
+rvm_bit_index (rtx mask, machine_mode mode, bool invert)
+{
+  if (!CONST_INT_P (mask))
+    return -1;
+  unsigned HOST_WIDE_INT value = UINTVAL (mask);
+  if (invert)
+    value = ~value;
+  return exact_log2 (value & GET_MODE_MASK (mode));
+}
+
+/* Clearing a low subword preserves all the other bits, like these masks,
+   but sets Z from that cleared subword rather than the whole result. */
+int
+rvm_low_clear_size (rtx mask, machine_mode mode)
+{
+  if (!CONST_INT_P (mask))
+    return 0;
+  unsigned HOST_WIDE_INT full = GET_MODE_MASK (mode);
+  unsigned HOST_WIDE_INT value = UINTVAL (mask) & full;
+  if (GET_MODE_BITSIZE (mode) > 8 && value == (full & ~HOST_WIDE_INT_UC (255)))
+    return 'b';
+  if (GET_MODE_BITSIZE (mode) > 16 && value == (full & ~HOST_WIDE_INT_UC (65535)))
+    return 'w';
+  if (GET_MODE_BITSIZE (mode) > 32 && value == (full & ~HOST_WIDE_INT_UC (0xffffffff)))
+    return 'l';
+  return 0;
+}
