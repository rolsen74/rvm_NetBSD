+;; Bit opcodes are quad-sized and set Z from the OLD bit.  Narrow register
+;; results may use them, but narrow memory references must never become a
+;; quad-sized access.  Mark every such result to prevent whole-result Z reuse.
+
+(define_insn "rvm_clear_low<mode>"
+  [(set (match_operand:RVM_INT 0 "register_operand" "=r")
+        (and:RVM_INT (match_operand:RVM_INT 1 "register_operand" "0")
+                     (match_operand:RVM_INT 2 "const_int_operand" "n")))]
+  "rvm_low_clear_size (operands[2], <MODE>mode) != 0"
+{
+  switch (rvm_low_clear_size (operands[2], <MODE>mode))
+    {
+    case 'b': return "rclr.b\t%0";
+    case 'w': return "rclr.w\t%0";
+    case 'l': return "rclr.l\t%0";
+    default: gcc_unreachable ();
+    }
+}
+  [(set_attr "rvm_result_z" "no")])
+
+(define_insn "rvm_bclr<mode>_const"
+  [(set (match_operand:RVM_INT 0 "nonimmediate_operand" "=r,m")
+        (and:RVM_INT (match_operand:RVM_INT 1 "nonimmediate_operand" "r,0")
+                       (match_operand:RVM_INT 2 "const_int_operand" "n,n")))]
+  "rvm_bit_index (operands[2], <MODE>mode, true) >= 0
+   && (<MODE>mode == DImode || (REG_P (operands[0]) && REG_P (operands[1])))"
+{
+  operands[3] = GEN_INT (rvm_bit_index (operands[2], <MODE>mode, true));
+  return REG_P (operands[0]) ? "vbclr\t%3,%1,%0" : "bclr\t%3,%0";
+}
+  [(set_attr "rvm_result_z" "no")])
+
+(define_insn "rvm_bclrdi_dynamic"
+  [(set (match_operand:DI 0 "nonimmediate_operand" "=r,m")
+        (and:DI (match_operand:DI 1 "nonimmediate_operand" "r,0")
+                  (not:DI (ashift:DI (const_int 1) (match_operand:DI 2 "register_operand" "r,r")))))]
+  ""
+  "@
+   rbclr\t%2,%1,%0
+   bclr\t%2,%0"
+  [(set_attr "rvm_result_z" "no")])
+
+(define_insn "rvm_bset<mode>_const"
+  [(set (match_operand:RVM_INT 0 "nonimmediate_operand" "=r,m")
+        (ior:RVM_INT (match_operand:RVM_INT 1 "nonimmediate_operand" "r,0")
+                       (match_operand:RVM_INT 2 "const_int_operand" "n,n")))]
+  "rvm_bit_index (operands[2], <MODE>mode, false) >= 0
+   && (<MODE>mode == DImode || (REG_P (operands[0]) && REG_P (operands[1])))"
+{
+  operands[3] = GEN_INT (rvm_bit_index (operands[2], <MODE>mode, false));
+  return REG_P (operands[0]) ? "vbset\t%3,%1,%0" : "bset\t%3,%0";
+}
+  [(set_attr "rvm_result_z" "no")])
+
+(define_insn "rvm_bsetdi_dynamic"
+  [(set (match_operand:DI 0 "nonimmediate_operand" "=r,m")
+        (ior:DI (match_operand:DI 1 "nonimmediate_operand" "r,0")
+                  (ashift:DI (const_int 1) (match_operand:DI 2 "register_operand" "r,r"))))]
+  ""
+  "@
+   rbset\t%2,%1,%0
+   bset\t%2,%0"
+  [(set_attr "rvm_result_z" "no")])
+
+(define_insn "rvm_bchg<mode>_const"
+  [(set (match_operand:RVM_INT 0 "nonimmediate_operand" "=r,m")
+        (xor:RVM_INT (match_operand:RVM_INT 1 "nonimmediate_operand" "r,0")
+                       (match_operand:RVM_INT 2 "const_int_operand" "n,n")))]
+  "rvm_bit_index (operands[2], <MODE>mode, false) >= 0
+   && (<MODE>mode == DImode || (REG_P (operands[0]) && REG_P (operands[1])))"
+{
+  operands[3] = GEN_INT (rvm_bit_index (operands[2], <MODE>mode, false));
+  return REG_P (operands[0]) ? "vbchg\t%3,%1,%0" : "bchg\t%3,%0";
+}
+  [(set_attr "rvm_result_z" "no")])
+
+(define_insn "rvm_bchgdi_dynamic"
+  [(set (match_operand:DI 0 "nonimmediate_operand" "=r,m")
+        (xor:DI (match_operand:DI 1 "nonimmediate_operand" "r,0")
