+/* Only reuse Z for adjacent, integer instructions with a single SET.
+   Labels, calls, inline asm and multi-instruction patterns are barriers.
+   Do this at final output, after scheduling and register allocation, so no
+   instruction can be inserted between the producer and the branch.  */
+bool
+rvm_branch_uses_z (rtx_insn *insn, rtx *operands)
+{
+  if ((GET_CODE (operands[0]) != EQ && GET_CODE (operands[0]) != NE)
+      || !REG_P (operands[1]) || operands[2] != const0_rtx)
+    return false;
+  rtx_insn *prev = prev_nonnote_nondebug_insn (insn);
+  if (!prev || !NONJUMP_INSN_P (prev) || GET_CODE (PATTERN (prev)) != SET)
+    return false;
+  rtx set = PATTERN (prev), dst = SET_DEST (set), src = SET_SRC (set);
+  machine_mode mode = GET_MODE (operands[1]);
+  if (!REG_P (dst) || !SCALAR_INT_MODE_P (GET_MODE (dst)))
+    return false;
+  bool same_dst = REGNO (dst) == REGNO (operands[1]);
+  if (GET_CODE (src) == ZERO_EXTEND)
+    return same_dst && (mode == GET_MODE (dst)
+                       || mode == GET_MODE (XEXP (src, 0)));
+  if (GET_MODE (dst) != mode)
+    return false;
+  switch (GET_CODE (src))
+    {
+    case REG:
+      return same_dst || rtx_equal_p (src, operands[1]);
+    case MEM:
+    case CONST_INT:
+    case AND:
+    case IOR:
+    case XOR:
+      return same_dst;
+    default:
+      return false;
+    }
+}
+
+/* Track a zero only within straight-line code, through exact-width or wider
+   register definitions.  Partial writes, calls and asm stop the search.  */
+bool
+rvm_zero_copy_p (rtx_insn *insn, rtx source)
+{
+  for (int limit = 0; limit < 32; ++limit)
+    {
+      insn = prev_nonnote_nondebug_insn (insn);
+      if (!insn || !NONJUMP_INSN_P (insn)
+          || GET_CODE (PATTERN (insn)) != SET
+          || asm_noperands (PATTERN (insn)) >= 0)
+        return false;
+      if (!modified_in_p (source, insn))
+        continue;
+      rtx set = single_set (insn);
+      if (!set || !REG_P (SET_DEST (set))
+          || REGNO (SET_DEST (set)) != REGNO (source)
+          || GET_MODE_SIZE (GET_MODE (SET_DEST (set))) < GET_MODE_SIZE (GET_MODE (source)))
+        return false;
+      return SET_SRC (set) == const0_rtx;
+    }
+  return false;
+}
