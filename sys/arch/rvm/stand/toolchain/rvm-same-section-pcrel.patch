+/* Carry precise instruction boundaries through the existing FHR symbol
+   format. The linker restores local binding for this reserved prefix and
+   only relaxes these sites after final output-section placement. */
+static void
+rvm_mark_pcrel_site (const uint8_t *bytes, int size, uint16_t opcode)
+{
+  static uint64_t identity;
+  static unsigned long serial;
+  static bool initialized;
+  char name[80];
+  symbolS *symbol;
+  if (!(now_seg->flags & SEC_CODE) || size < 11 || bytes[2] != OAM_55)
+    return;
+  switch (opcode)
+    {
+    case Opcode_Jsr: case Opcode_Jmp: case Opcode_Lea_q:
+    case Opcode_Bss: case Opcode_Bsc: case Opcode_Bcs: case Opcode_Bcc:
+    case Opcode_Bvs: case Opcode_Bvc: case Opcode_Beq: case Opcode_Bne:
+    case Opcode_Bmi: case Opcode_Bpl: case Opcode_Bxs: case Opcode_Bxc:
+    case Opcode_Bhi: case Opcode_Bls: case Opcode_Bgt: case Opcode_Bge:
+    case Opcode_Blt: case Opcode_Ble: case Opcode_Bis: case Opcode_Bic:
+      break;
+    default:
+      return;
+    }
+  if (!initialized)
+    {
+      char *path = lrealpath (out_file_name);
+      const unsigned char *p = (const unsigned char *)(path ? path : out_file_name);
+      identity = UINT64_C (14695981039346656037);
+      while (*p)
+        { identity ^= *p++; identity *= UINT64_C (1099511628211); }
+      free (path);
+      initialized = true;
+    }
+  snprintf (name, sizeof (name), "__rvm_pcrel_%016" PRIx64 "_%lu", identity, serial++);
+  symbol = symbol_new (name, now_seg, frag_now,
+                       (const char *)bytes - frag_now->fr_literal);
+  /* GAS/FHR otherwise omits unreferenced local definitions. These are
+     mapping symbols rather than public entry points in the final linker. */
+  S_SET_EXTERNAL (symbol);
+  symbol_table_insert (symbol);
+}
