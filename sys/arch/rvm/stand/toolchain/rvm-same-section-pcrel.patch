+static int
+fhr_Compare_Pcrel_Sites (const void *a, const void *b)
+{
+  const struct fhr_pcrel_site *left = a, *right = b;
+  if (left->section != right->section)
+    return left->section < right->section ? -1 : 1;
+  return left->field < right->field ? -1 : left->field != right->field;
+}
+
+static bool
+fhr_Is_Pcrel_Site (asection *section, bfd_vma field)
+{
+  struct fhr_data *data = section->owner->tdata.any;
+  struct fhr_pcrel_site key;
+  int i;
+  if (!data)
+    return false;
+  if (!data->PcrelIndexed)
+    {
+      size_t count = 0;
+      for (i = 0; i < data->InputSymbolCount; ++i)
+        if (strncmp (data->InputSymbols[i]->name, FHR_PCREL_MARKER,
+                     sizeof (FHR_PCREL_MARKER) - 1) == 0)
+          ++count;
+      if (count)
+        {
+          data->PcrelSites = bfd_alloc (section->owner,
+                                       count * sizeof (*data->PcrelSites));
+          if (!data->PcrelSites)
+            return false;
+          for (i = 0; i < data->InputSymbolCount; ++i)
+            {
+              asymbol *sym = data->InputSymbols[i];
+              if (strncmp (sym->name, FHR_PCREL_MARKER,
+                           sizeof (FHR_PCREL_MARKER) - 1) != 0)
+                continue;
+              data->PcrelSites[data->PcrelCount].section = sym->section->index;
+              /* Opcode (2), addressing mode (1), then the 64-bit address. */
+              data->PcrelSites[data->PcrelCount++].field = sym->value + 3;
+            }
+          qsort (data->PcrelSites, data->PcrelCount,
+                 sizeof (*data->PcrelSites), fhr_Compare_Pcrel_Sites);
+        }
+      data->PcrelIndexed = true;
+    }
+  if (!data->PcrelCount)
+    return false;
+  key.section = section->index;
+  key.field = field;
+  return bsearch (&key, data->PcrelSites, data->PcrelCount,
+                  sizeof (*data->PcrelSites), fhr_Compare_Pcrel_Sites) != NULL;
+}
+
+static bool
+fhr_Relax_Pcrel (bfd *abfd, struct fhr_section_data *data,
+                 asection *input, arelent *reloc, bfd_vma offset)
+{
+  unsigned int opcode;
+  bfd_vma value;
+  if (!(data->sec->flags & SEC_CODE)
+      || !fhr_Is_Pcrel_Site (input, reloc->address)
+      || !data->buf_data || offset < 3 || offset > data->buf_size
+      || data->buf_size - offset < 8 || data->buf_data[offset - 1] != 0x37)
+    return false;
+  opcode = bfd_get_16 (abfd, data->buf_data + offset - 3);
+  /* Validate the mapping site's instruction and first-operand mode. Never
+     infer instruction boundaries from bytes alone: .text may hold pointers. */
+  switch (opcode)
+    {
+    case 0x005d: case 0x005e: case 0x005f: /* JSR, JMP, LEA. */
+    case 0x007a: case 0x007b: case 0x007e: case 0x007f:
+    case 0x0082: case 0x0083: case 0x0086: case 0x0087:
+    case 0x008a: case 0x008b: case 0x008e: case 0x008f:
+    case 0x0090: case 0x0091: case 0x0092: case 0x0093:
+    case 0x0094: case 0x0095: case 0x0102: case 0x0103:
+      break;
+    default:
+      return false;
+    }
+  value = bfd_get_64 (abfd, data->buf_data + offset);
+  value -= data->sec->vma + offset - 3; /* PC is the opcode address. */
+  data->buf_data[offset - 1] = 0x33;    /* (signed d64, PC), same size. */
+  bfd_put_64 (abfd, value, data->buf_data + offset);
+  return true;
 }
 
