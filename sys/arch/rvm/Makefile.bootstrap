$(OBJDIR)/lwp_startup.o: $(SRC_TOP)/sys/kern/kern_lwp.c $(RVM_DIR)/stand/lwp_source.py $(RVM_DIR)/stand/fhr_asm.py $(HEADERS) $(BOOT_OPTIONS) $(RVM_DIR)/Makefile.bootstrap
	python3 "$(RVM_DIR)/stand/lwp_source.py" "$<" "$(OBJDIR)/lwp_startup.c"
	$(RVM_CC) $(BOOT_CFLAGS) -Wno-unused-parameter $(HEADER_FLAGS) -MF "$(OBJDIR)/lwp_startup.d" -MT "$@" -S "$(OBJDIR)/lwp_startup.c" -o "$(OBJDIR)/lwp_startup.raw.s"
