$(OBJDIR)/cpuswitch.o: $(RVM_DIR)/rvm/cpuswitch.S $(HEADERS) $(RVM_DIR)/Makefile.bootstrap | $(OBJDIR)/include/machine
	$(RVM_CC) -nostdinc $(HEADER_FLAGS) -E -P -x assembler-with-cpp "$<" -o "$(OBJDIR)/cpuswitch.vma"
	$(VMASM) -i "$(OBJDIR)/cpuswitch.vma" -o "$@" --obj

$(BOOT_OPTIONS): | $(OBJDIR)/include/machine
	printf '%s\n' '/* Standalone UP bootstrap: option disabled. */' > "$@"

# Compile real MI sources. Profiles keep selected entry points and reject
# unavailable object/scheduler facilities; normal kernel builds do not use them.
# FHR assembly normalization handles string labels and common storage.
MI_CFLAGS := -DNO_KERNEL_RCSIDS -Wno-unused-parameter -Wno-sign-compare -Wno-pointer-sign
define MI_OBJECT
$(OBJDIR)/$(1).o: $(SRC_TOP)/$(2) $(RVM_DIR)/stand/fhr_asm.py $(RVM_DIR)/stand/uvm_profile.h $(HEADERS) $(BOOT_OPTIONS) $(RVM_DIR)/Makefile.bootstrap
	$(RVM_CC) $(BOOT_CFLAGS) $(MI_CFLAGS) $(HEADER_FLAGS) $(if $(3),-fwhole-program -DRVM_BOOT_$(3) -include "$(RVM_DIR)/stand/uvm_profile.h") -MF "$(OBJDIR)/$(1).d" -MT "$$@" -S "$$<" -o "$(OBJDIR)/$(1).raw.s"
	python3 "$(RVM_DIR)/stand/fhr_asm.py" "$(OBJDIR)/$(1).raw.s" "$(OBJDIR)/$(1).s" --cc "$(RVM_CC)"
	$(RVM_CC) -c "$(OBJDIR)/$(1).s" -o "$$@"
endef
$(eval $(call MI_OBJECT,strlen,common/lib/libc/string/strlen.c,))
$(eval $(call MI_OBJECT,memchr,common/lib/libc/string/memchr.c,))
$(eval $(call MI_OBJECT,uvm_physseg,sys/uvm/uvm_physseg.c,))
$(eval $(call MI_OBJECT,uvm_page,sys/uvm/uvm_page.c,PAGE))
$(eval $(call MI_OBJECT,uvm_extent,sys/kern/subr_extent.c,EXTENT))
$(eval $(call MI_OBJECT,uvm_clock,sys/uvm/uvm_pdpolicy_clock.c,CLOCK))
$(eval $(call MI_OBJECT,uvm_meter,sys/uvm/uvm_meter.c,METER))
$(eval $(call MI_OBJECT,uvm_pgflcache,sys/uvm/uvm_pgflcache.c,))
$(eval $(call MI_OBJECT,rbtree,common/lib/libc/gen/rbtree.c,))
$(eval $(call MI_OBJECT,uvm_object,sys/uvm/uvm_object.c,OBJECT))
$(eval $(call MI_OBJECT,uvm_page_status,sys/uvm/uvm_page_status.c,STATUS))
$(eval $(call MI_OBJECT,radixtree,common/lib/libc/gen/radixtree.c,RADIX))
$(eval $(call MI_OBJECT,uvm_km,sys/uvm/uvm_km.c,KM))
$(eval $(call MI_OBJECT,vmem,sys/arch/rvm/stand/vmem.c,VMEM))
$(OBJDIR)/vmem.o: $(SRC_TOP)/sys/kern/subr_vmem.c
$(eval $(call MI_OBJECT,pool,sys/arch/rvm/stand/pool.c,POOL))
$(OBJDIR)/pool.o: $(SRC_TOP)/sys/kern/subr_pool.c
$(eval $(call MI_OBJECT,uvm_anon,sys/arch/rvm/stand/anon.c,ANON))
$(OBJDIR)/uvm_anon.o: $(SRC_TOP)/sys/uvm/uvm_anon.c
$(eval $(call MI_OBJECT,uvm_amap,sys/arch/rvm/stand/amap.c,AMAP))
$(OBJDIR)/uvm_amap.o: $(SRC_TOP)/sys/uvm/uvm_amap.c

# Runtime callback initialization works around FHR static function pointers.
$(OBJDIR)/uvm_map.o: $(SRC_TOP)/sys/uvm/uvm_map.c $(RVM_DIR)/stand/map_source.py $(RVM_DIR)/stand/uvm_profile.h $(RVM_DIR)/stand/fhr_asm.py $(HEADERS) $(BOOT_OPTIONS) $(RVM_DIR)/Makefile.bootstrap
	python3 "$(RVM_DIR)/stand/map_source.py" "$<" "$(OBJDIR)/uvm_map.c"
	$(RVM_CC) $(BOOT_CFLAGS) $(MI_CFLAGS) $(HEADER_FLAGS) -fwhole-program -DRVM_BOOT_MAP -include "$(RVM_DIR)/stand/uvm_profile.h" -MF "$(OBJDIR)/uvm_map.d" -MT "$@" -S "$(OBJDIR)/uvm_map.c" -o "$(OBJDIR)/uvm_map.raw.s"
	python3 "$(RVM_DIR)/stand/fhr_asm.py" "$(OBJDIR)/uvm_map.raw.s" "$(OBJDIR)/uvm_map.s" --cc "$(RVM_CC)"
	$(RVM_CC) -c "$(OBJDIR)/uvm_map.s" -o "$@"

$(OBJDIR)/locore.o: $(RVM_DIR)/rvm/locore.S $(HEADERS) $(RVM_DIR)/Makefile.bootstrap | $(OBJDIR)/include/machine
	$(RVM_CC) -nostdinc $(HEADER_FLAGS) -E -P -x assembler-with-cpp "$<" -o "$(OBJDIR)/locore.vma"
	$(VMASM) -i "$(OBJDIR)/locore.vma" -o "$@" --obj

$(OBJDIR)/netbsd.fhr: $(BOOT_OBJS) $(RVM_DIR)/Makefile.bootstrap
	$(RVM_LD) -e _start -Map "$(OBJDIR)/netbsd.map" -o "$@" $(BOOT_OBJS)

$(OBJDIR)/netbsd.fhr: | check

$(OBJDIR)/bootloader.bin: $(BOOT_SOURCES) $(HEADERS) $(RVM_DIR)/Makefile.bootstrap | $(OBJDIR)/include/machine
	$(RVM_CC) -nostdinc $(HEADER_FLAGS) -E -P -x assembler-with-cpp "$(RVM_DIR)/stand/boot/Source.vma" -o "$(OBJDIR)/bootloader.vma"
	$(VMASM) -I "$(RVM_DIR)/stand/boot/includes_i" -I "$(RVM_DIR)/stand/boot" -i "$(OBJDIR)/bootloader.vma" -o "$@" --bin --optimize

$(OBJDIR)/vm.config: $(RVM_DIR)/conf/vmemu.conf | $(OBJDIR)
	cp "$<" "$@"

run: all
	cd "$(OBJDIR)" && $(VMEMU) -c vm.config

test: all
	python3 "$(RVM_DIR)/tests/bootstrap.py" --objdir "$(OBJDIR)" \
	    --cross "$(CROSS_COMPILE)" \
	    --vmasm "$(VMASM)" --vmemu "$(VMEMU)" --suite "$(TEST_SUITE)"

clean:
	rm -f "$(OBJDIR)/abi-check.o" "$(OBJDIR)/locore.o" \
	    "$(OBJDIR)/machdep.o" "$(OBJDIR)/earlycons.o" \
	    "$(OBJDIR)/bootmem.o" "$(OBJDIR)/pmap.o" "$(OBJDIR)/bootloader.vma" \
	    "$(OBJDIR)/uvm_machdep.o" "$(OBJDIR)/uvm_bootstrap.o" \
	    "$(OBJDIR)/uvm_physseg.o" "$(OBJDIR)/uvm_physseg.raw.s" "$(OBJDIR)/uvm_physseg.s" \
	    "$(OBJDIR)/netbsd.fhr" "$(OBJDIR)/netbsd.map" \
	    "$(OBJDIR)/bootloader.bin" "$(OBJDIR)/vm.config" "$(OBJDIR)/locore.vma"
	rm -f $(MI_OBJS) $(MI_OBJS:.o=.raw.s) $(MI_OBJS:.o=.s) "$(OBJDIR)/uvm_support.o" "$(OBJDIR)/bootalloc.o"
	rm -f $(BOOT_OBJS:.o=.d) "$(OBJDIR)/abi-check.d"
	rm -f "$(OBJDIR)/uvm_map.c"
	rm -f "$(OBJDIR)/bootmap.o"
	rm -f "$(OBJDIR)/bootobject.o"
	rm -f "$(OBJDIR)/bootkm.o"
	rm -f "$(OBJDIR)/bootheap.o"
	rm -f "$(OBJDIR)/bootpool.o" "$(OBJDIR)/bootcache.o" "$(OBJDIR)/bootanon.o" "$(OBJDIR)/bootamap.o" "$(OBJDIR)/bootanonmap.o" "$(OBJDIR)/cpu_switch.o" "$(OBJDIR)/cpuswitch.o" "$(OBJDIR)/cpuswitch.vma"
	rm -f "$(OBJDIR)/vm_machdep.o" "$(OBJDIR)/lwp_startup.o" "$(OBJDIR)/lwp_startup.c" "$(OBJDIR)/lwp_startup.raw.s" "$(OBJDIR)/lwp_startup.s"

	rm -f "$(OBJDIR)/bootsched.o" "$(OBJDIR)/mi_switch.o" "$(OBJDIR)/mi_switch.c" "$(OBJDIR)/mi_switch.raw.s" "$(OBJDIR)/mi_switch.s"

	rm -f "$(OBJDIR)/runq.o" "$(OBJDIR)/runq.c" "$(OBJDIR)/runq.raw.s" "$(OBJDIR)/runq.s"

	rm -f "$(OBJDIR)/idle_loop.o" "$(OBJDIR)/idle_loop.c" "$(OBJDIR)/idle_loop.raw.s" "$(OBJDIR)/idle_loop.s"

	rm -f "$(OBJDIR)/trap.o" "$(OBJDIR)/trap_probe.o"

	rm -f "$(OBJDIR)/irq.o" "$(OBJDIR)/irq.raw.s" "$(OBJDIR)/irq.s" "$(OBJDIR)/irq_probe.o"
	rm -f "$(OBJDIR)/intr.o" "$(OBJDIR)/intr.raw.s" "$(OBJDIR)/intr.s"
	rm -f "$(OBJDIR)/asyncirq.o" "$(OBJDIR)/asyncirq.vma" "$(OBJDIR)/async_probe.o"
	rm -f "$(OBJDIR)/async_verify.o" "$(OBJDIR)/async_verify.raw.s" "$(OBJDIR)/async_verify.s"

	rm -f "$(OBJDIR)/clock_probe.o" "$(OBJDIR)/clock.o" "$(OBJDIR)/clock.raw.s" "$(OBJDIR)/clock.s" "$(OBJDIR)/clock_verify.o" "$(OBJDIR)/clock_verify.raw.s" "$(OBJDIR)/clock_verify.s"

	rm -f "$(OBJDIR)/bootclock.o" "$(OBJDIR)/bootclock.raw.s" "$(OBJDIR)/bootclock.s" "$(OBJDIR)/hardclock.o" "$(OBJDIR)/hardclock.c" "$(OBJDIR)/hardclock.raw.s" "$(OBJDIR)/hardclock.s" "$(OBJDIR)/callout.o" "$(OBJDIR)/callout.c" "$(OBJDIR)/callout.raw.s" "$(OBJDIR)/callout.s"

	rm -f "$(OBJDIR)/timecounter.o" "$(OBJDIR)/timecounter.c" "$(OBJDIR)/timecounter.raw.s" "$(OBJDIR)/timecounter.s"

	rm -f "$(OBJDIR)/uarea.o"

	rm -f "$(OBJDIR)/lwpvm.o" "$(OBJDIR)/lwpvm.c" "$(OBJDIR)/lwpvm.raw.s" "$(OBJDIR)/lwpvm.s"
	rm -f "$(OBJDIR)/wait.o" "$(OBJDIR)/wait.c" "$(OBJDIR)/wait.raw.s" "$(OBJDIR)/wait.s" "$(OBJDIR)/wait_abi.o"
	rm -f "$(OBJDIR)/wait_verify.o" "$(OBJDIR)/wait_verify.raw.s" "$(OBJDIR)/wait_verify.s"

	rm -f "$(OBJDIR)/softint.o" "$(OBJDIR)/softint.c" "$(OBJDIR)/softint.raw.s" "$(OBJDIR)/softint.s" "$(OBJDIR)/softint_verify.o" "$(OBJDIR)/softint_verify.raw.s" "$(OBJDIR)/softint_verify.s"

	rm -f "$(OBJDIR)/prf.o" "$(OBJDIR)/prf.c" "$(OBJDIR)/prf.raw.s" "$(OBJDIR)/prf.s"

	rm -f "$(OBJDIR)/pmap.raw.s" "$(OBJDIR)/pmap.s" "$(OBJDIR)/pmap_verify.o" "$(OBJDIR)/pmap_verify.raw.s" "$(OBJDIR)/pmap_verify.s"

	rm -f "$(OBJDIR)/kcopy.o" "$(OBJDIR)/kcopy.raw.s" "$(OBJDIR)/kcopy.s" "$(OBJDIR)/copy.o" "$(OBJDIR)/copy.vma"

-include $(wildcard $(OBJDIR)/*.d)
