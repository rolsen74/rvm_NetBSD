$(OBJDIR)/lwpvm.o: $(SRC_TOP)/sys/uvm/uvm_glue.c $(RVM_DIR)/stand/lwpvm_source.py $(RVM_DIR)/stand/bootlwpvm.c $(RVM_DIR)/stand/fhr_asm.py $(HEADERS) $(RVM_DIR)/Makefile.bootstrap | $(OBJDIR)/include/machine
	python3 "$(RVM_DIR)/stand/lwpvm_source.py" "$<" "$(OBJDIR)/lwpvm.c" "$(RVM_DIR)/stand/bootlwpvm.c"
