$(OBJDIR)/wait.o: $(SRC_TOP)/sys/kern/kern_sleepq.c $(SRC_TOP)/sys/kern/kern_condvar.c $(SRC_TOP)/sys/kern/kern_synch.c $(RVM_DIR)/stand/wait_source.py $(RVM_DIR)/stand/bootwait.c $(RVM_DIR)/stand/fhr_asm.py $(HEADERS) $(RVM_DIR)/Makefile.bootstrap | $(OBJDIR)/include/machine
