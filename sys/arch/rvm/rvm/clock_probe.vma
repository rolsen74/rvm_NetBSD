        mtctrl r0,cr
        xdef rvm_clock_halt_pc
rvm_clock_halt_pc:
        halt
        xdef rvm_clock_after_halt
rvm_clock_after_halt:
        pushm r0-r62
        mfctrl sr,r2
        move.q #8,r0
        mtctrl r0,cr
        cmp.q #0x3f,r2
