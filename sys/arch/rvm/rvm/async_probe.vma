; Busy interrupt return: every non-scratch GPR and the caller SP survive.
        section ".text",code
        xdef rvm_async_register_probe
        xref rvm_async_probe_done
rvm_async_register_probe:
        pushm r0-r62
        lea rvm_async_probe_sp,r0
        move.q r63,(r0)
        move.q #0x50002,r2
        move.q #0x50003,r3
        move.q #0x50004,r4
        move.q #0x50005,r5
        move.q #0x50006,r6
        move.q #0x50007,r7
        move.q #0x50008,r8
        move.q #0x50009,r9
        move.q #0x5000a,r10
        move.q #0x5000b,r11
        move.q #0x5000c,r12
        move.q #0x5000d,r13
        move.q #0x5000e,r14
        move.q #0x5000f,r15
        move.q #0x50010,r16
        move.q #0x50011,r17
        move.q #0x50012,r18
        move.q #0x50013,r19
        move.q #0x50014,r20
        move.q #0x50015,r21
        move.q #0x50016,r22
        move.q #0x50017,r23
        move.q #0x50018,r24
        move.q #0x50019,r25
        move.q #0x5001a,r26
        move.q #0x5001b,r27
        move.q #0x5001c,r28
        move.q #0x5001d,r29
        move.q #0x5001e,r30
        move.q #0x5001f,r31
        move.q #0x50020,r32
        move.q #0x50021,r33
        move.q #0x50022,r34
        move.q #0x50023,r35
        move.q #0x50024,r36
        move.q #0x50025,r37
        move.q #0x50026,r38
        move.q #0x50027,r39
        move.q #0x50028,r40
        move.q #0x50029,r41
        move.q #0x5002a,r42
        move.q #0x5002b,r43
        move.q #0x5002c,r44
        move.q #0x5002d,r45
        move.q #0x5002e,r46
        move.q #0x5002f,r47
        move.q #0x50030,r48
        move.q #0x50031,r49
        move.q #0x50032,r50
        move.q #0x50033,r51
        move.q #0x50034,r52
        move.q #0x50035,r53
        move.q #0x50036,r54
        move.q #0x50037,r55
        move.q #0x50038,r56
        move.q #0x50039,r57
        move.q #0x5003a,r58
        move.q #0x5003b,r59
        move.q #0x5003c,r60
        move.q #0x5003d,r61
        move.q #0x5003e,r62
        lea rvm_async_probe_done,r1
.Lbusy:
        move.q (r1),r0
        cmp.q #0,r0
        beq .Lbusy
        pushm r0-r62
        move.q #8,r0
        mtctrl r0,cr
        lea (16,r63),r2
        move.q #0x50002,r3
        move.q #61,r4
.Lcheck:
        move.q (r2)+,r5
        cmp.q r3,r5
        bne .Lbad
        add.q #1,r3
        sub.q #1,r4
        bne .Lcheck
        lea (504,r63),r2
        lea rvm_async_probe_sp,r3
        move.q (r3),r3
        cmp.q r2,r3
        bne .Lbad
        popm r0-r62
        popm r0-r62
        move.q #1,r0
        rts
.Lbad:
        popm r0-r62
        popm r0-r62
        rclr.q r0
        rts
        section ".data",data
        SecAlign 8
rvm_async_probe_sp:
        dc.q 0
